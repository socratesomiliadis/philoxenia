---
interface Props { variant: 'hero' | 'possibility' | 'door'; }
const { variant } = Astro.props;
const photos = {
  hero: [
    { name: 'alumni-1', width: 640, height: 853 },
    { name: 'alumni-4', width: 640, height: 853 },
    { name: 'alumni-9', width: 640, height: 853 },
  ],
  possibility: [
    { name: 'bezosyoung', width: 640, height: 853 },
    { name: 'billyoung', width: 640, height: 853 },
    { name: 'steveyoung', width: 625, height: 819 },
    { name: 'sama', width: 640, height: 853 },
    { name: 'jensen', width: 235, height: 147 },
  ],
  door: [
    { name: 'markyoung', width: 620, height: 547 },
    { name: 'elonyoung', width: 640, height: 449 },
    { name: 'goog', width: 634, height: 847 },
    { name: 'elonagain', width: 640, height: 646 },
    { name: 'stevebill', width: 640, height: 720 },
  ],
}[variant];
---
<div class:list={['photo-collage', `photo-collage--${variant}`]} aria-hidden="true" data-enter-media={variant === 'hero' ? '' : undefined}>
  {photos.map((photo, i) => <div class:list={['collage-photo', `collage-photo--${i + 1}`]}>
    <img src={`/images/${photo.name}.webp`} srcset={photo.width > 320 ? `/images/${photo.name}-160.webp 160w, /images/${photo.name}-320.webp 320w, /images/${photo.name}.webp ${photo.width}w` : `/images/${photo.name}-160.webp 160w, /images/${photo.name}.webp ${photo.width}w`} sizes="(max-width: 639px) 44vw, (max-width: 1099px) 220px, 300px" width={photo.width} height={photo.height} alt="" loading={variant === 'hero' ? 'eager' : 'lazy'} decoding="async" data-source="client" data-subject={variant === 'hero' ? 'Philoxenia community photograph' : 'Historical founder photograph from the original Philoxenia website'} />
  </div>)}
</div>
