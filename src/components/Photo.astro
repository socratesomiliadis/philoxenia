---
interface Props {
  name: string;
  alt: string;
  class?: string;
  width?: number;
  height?: number;
  sizes?: string;
}
const { name, alt, class: className, width = 640, height = 853, sizes = '(max-width: 639px) calc(100vw - 48px), 40vw' } = Astro.props;
const srcset = [`/images/${name}-320.webp 320w`, width > 640 ? `/images/${name}-640.webp 640w` : null, `/images/${name}.webp ${width}w`].filter(Boolean).join(', ');
---
<img src={`/images/${name}.webp`} srcset={srcset} alt={alt} class={className} width={width} height={height} sizes={sizes} loading="lazy" decoding="async" data-source="client" data-subject={alt} />
